.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
# The operator's own site config, which lives at the root beside
# site.example.yaml. Anchored, because unanchored it also swallowed the local
# stack's checked-in deploy/compose/local/site.yaml — whose addresses are
# compose service names and whose credentials are MinIO's defaults.
/site.yaml
runs/*/
!runs/*.yaml
dist/
