# The catalog block of site.yaml, as the KEY=VALUE lines the table tools take
# via --catalog-prop-file. A file rather than repeated --catalog-prop flags
# because a credential on argv lands in every process listing; here it stays
# in a mount.
#
# Mounted at /catalog.props in the harness container:
#   create-table --catalog-prop-file /catalog.props --table bench.events …
uri=http://iceberg-rest:8181
warehouse=s3://warehouse/
s3.endpoint=http://minio:9000
s3.access-key-id=admin
s3.secret-access-key=password
s3.path-style-access=true
s3.region=us-east-1
