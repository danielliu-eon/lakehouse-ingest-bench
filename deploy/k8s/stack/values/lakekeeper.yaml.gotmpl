# Lakekeeper with the chart's bundled Postgres. Authentication stays off — the
# chart's default when no provider is named — and the default `allowall`
# authorization stands: both are reachable only inside the cluster, and the
# broker beside them is equally open.
serviceAccount:
  create: true
  # Fixed, because a pod identity association is per (namespace, account).
  name: ingest-bench-catalog

# The migration Job runs before the catalog can start. At the chart's default
# it is a post-install hook, which Helm runs only after `--wait` returns — so
# the catalog would never become ready inside the wait. `true` makes it an
# ordinary release resource instead.
helmWait: true

catalog:
  replicas: 1
  # The cloud's own switches and environment, from the hook.
  config: {{ requiredEnv "STACK_CATALOG_CONFIG_JSON" }}
  extraEnv: {{ requiredEnv "STACK_CATALOG_ENV_JSON" }}
  nodeSelector: {{ requiredEnv "CATALOG_NODE_SELECTOR" }}
  tolerations: {{ requiredEnv "CATALOG_TOLERATIONS" }}
  resources:
    requests:
      cpu: 500m
      memory: 1Gi
  dbMigrations:
    # A new Job per revision, so a re-run does not accumulate them.
    ttlSecondsAfterFinished: 600

# The key the catalog encrypts stored secrets with, from a Secret setup.sh
# makes once and never regenerates: a new key would lose what is already stored.
secretBackend:
  type: Postgres
  postgres:
    encryptionKeySecret: {{ requiredEnv "CATALOG_SECRET" }}
    encryptionKeySecretKey: encryptionKey

postgresql:
  enabled: true
  settings:
    existingSecret: {{ requiredEnv "CATALOG_SECRET" }}
    superuser:
      secretKey: postgresUser
    superuserPassword:
      secretKey: postgresPassword
  userDatabase:
    existingSecret: {{ requiredEnv "CATALOG_SECRET" }}
    name:
      secretKey: pgDatabase
    user:
      secretKey: pgUser
    password:
      secretKey: pgPassword
  storage:
    requestedSize: 10Gi
    className: {{ requiredEnv "KAFKA_STORAGE_CLASS" }}
  nodeSelector: {{ requiredEnv "CATALOG_NODE_SELECTOR" }}
  tolerations: {{ requiredEnv "CATALOG_TOLERATIONS" }}
