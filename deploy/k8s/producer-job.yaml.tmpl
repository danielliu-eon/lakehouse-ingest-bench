# One producer shard per pod. The shards of a run share the corpus, the topic
# and the epoch and differ only in their index, which indexed completion gives
# them: `$JOB_COMPLETION_INDEX` reaches the command line through the image's
# shell entrypoint.
#
# The publish log is written to an `emptyDir` and uploaded to the run's prefix
# as it goes, because it is the scorer's input and the scorer is another pod.
apiVersion: batch/v1
kind: Job
metadata:
  name: __NAME__
  namespace: __NAMESPACE__
  labels:
    lakehouse-ingest-bench: "true"
spec:
  backoffLimit: 0
  completionMode: Indexed
  completions: __COUNT__
  parallelism: __COUNT__
  template:
    metadata:
      labels:
        lakehouse-ingest-bench: "true"
    spec:
      restartPolicy: Never
      serviceAccountName: __SERVICE_ACCOUNT__
      nodeSelector: __NODE_SELECTOR__
      tolerations: __TOLERATIONS__
      containers:
        - name: harness
          image: __IMAGE__
          args: ["__COMMAND__"]
          env: __ENV__
          # Every key of the Secret site.kubernetes.secret_name names, as
          # environment variables. This is what a `${env:NAME}` in a property
          # resolves against: the manifest and the command line carry the
          # reference, and the value exists only in that Secret.
          envFrom: __ENV_FROM__
          # A shard reads one whole batch object into memory and decompresses
          # it whole, so its peak is set by the preset's batch bytes and not by
          # the shard count: sharding buys throughput, never headroom. The
          # driver's PRODUCER_MEMORY is what raises this for a preset whose
          # batch is larger than the smoke one's.
          resources:
            requests:
              cpu: "1"
              memory: __MEMORY__
          volumeMounts:
            - name: work
              mountPath: /work
      volumes:
        - name: work
          emptyDir: {}
