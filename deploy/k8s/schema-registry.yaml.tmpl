# A Confluent-API schema registry in the harness's namespace, for runs whose
# spec says `kafka.value_encoding: confluent`. Applied by deploy/aws/setup.sh
# when WITH_SCHEMA_REGISTRY=true, and deleted with the namespace by
# teardown.sh.
#
# One replica with in-memory storage, which is Apicurio's default. A run
# registers one schema at staging and every reader resolves it by id for the
# rest of the run, so the registry holds a handful of documents and losing
# them ends only the runs that were using it. A site that needs a registry to
# outlive a pod brings its own and names it in site.yaml instead.
#
# Rendered by substituting its markers, like every template under deploy/k8s/.
# See the templating note in deploy/aws/README.md.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: schema-registry
  namespace: __NAMESPACE__
  labels:
    lakehouse-ingest-bench: "true"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: schema-registry
  template:
    metadata:
      labels:
        app: schema-registry
        lakehouse-ingest-bench: "true"
    spec:
      nodeSelector: __NODE_SELECTOR__
      tolerations: __TOLERATIONS__
      containers:
        - name: schema-registry
          image: quay.io/apicurio/apicurio-registry:3.0.15
          ports:
            - name: http
              containerPort: 8080
          # The registry answers on its port before it will serve a
          # registration, and a `stage` that arrives in between fails on a
          # connection it cannot make. The probes are what hold the Service's
          # endpoint back until that stops being possible.
          readinessProbe:
            httpGet: {path: /health/ready, port: http}
            periodSeconds: 5
          livenessProbe:
            httpGet: {path: /health/live, port: http}
            periodSeconds: 20
          resources:
            requests:
              cpu: "200m"
              memory: "512Mi"
---
apiVersion: v1
kind: Service
metadata:
  name: schema-registry
  namespace: __NAMESPACE__
  labels:
    lakehouse-ingest-bench: "true"
spec:
  selector:
    app: schema-registry
  ports:
    - name: http
      port: 8080
      targetPort: http
