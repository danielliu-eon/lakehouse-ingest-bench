# One scorer observes commits and publish logs through the drain phase,
# uploading artifacts incrementally. Keep a single observer so each commit
# has one visibility timestamp for freshness measurements.
apiVersion: batch/v1
kind: Job
metadata:
  name: __NAME__
  namespace: __NAMESPACE__
  labels:
    lakehouse-ingest-bench: "true"
spec:
  backoffLimit: 0
  completions: 1
  template:
    metadata:
      labels:
        lakehouse-ingest-bench: "true"
    spec:
      restartPolicy: Never
      serviceAccountName: __SERVICE_ACCOUNT__
      nodeSelector: __NODE_SELECTOR__
      tolerations: __TOLERATIONS__
      containers:
        - name: harness
          image: __IMAGE__
          args: ["__COMMAND__"]
          env: __ENV__
          envFrom: __ENV_FROM__
          # Request two cores for commit ID scans and Parquet decoding. Read only
          # ID columns and release each file after tallying it.
          resources:
            requests:
              cpu: "2"
              memory: "2Gi"
          volumeMounts:
            - name: work
              mountPath: /work
      volumes:
        - name: work
          emptyDir: {}
