# The scorer, one pod for the whole run. It reads the table's commits and the
# producers' publish logs from the moment the offer starts until the table
# drains, and publishes every artifact as it goes — so a run that dies part way
# through still says how far it got.
#
# One pod, and never more: two readers of one table would disagree about when a
# commit became visible, and the run's freshness figures come from exactly one
# of those judgements.
apiVersion: batch/v1
kind: Job
metadata:
  name: __NAME__
  namespace: __NAMESPACE__
  labels:
    lakehouse-ingest-bench: "true"
spec:
  backoffLimit: 0
  completions: 1
  template:
    metadata:
      labels:
        lakehouse-ingest-bench: "true"
    spec:
      restartPolicy: Never
      serviceAccountName: __SERVICE_ACCOUNT__
      nodeSelector: __NODE_SELECTOR__
      tolerations: __TOLERATIONS__
      containers:
        - name: harness
          image: __IMAGE__
          args: ["__COMMAND__"]
          env: __ENV__
          # Every key of the Secret site.kubernetes.secret_name names, as
          # environment variables. This is what a `${env:NAME}` in a property
          # resolves against: the manifest and the command line carry the
          # reference, and the value exists only in that Secret.
          envFrom: __ENV_FROM__
          # Two cores because a poll reads a whole commit's id columns at once,
          # and each of those reads decodes a Parquet footer and a column chunk
          # through a bridge that holds the interpreter for every request it
          # makes. Memory is not what the width costs: only the id column of a
          # file is read, and at most `--read-workers` of them are in flight.
          resources:
            requests:
              cpu: "2"
              memory: "2Gi"
          volumeMounts:
            - name: work
              mountPath: /work
      volumes:
        - name: work
          emptyDir: {}
